{
  "name": "magic-acm-context",
  "version": "0.1.0",
  "description": "Magic Context + ACM (Active Context Management) unified extension for pi and omp",
  "workspaces": [
    "packages/*"
  ],
  "pi": {
    "extensions": [
      "./packages/pi-plugin/src/index.ts"
    ]
  },
  "omp": {
    "extensions": [
      "./packages/omp-plugin/dist/index.js"
    ]
  },
  "peerDependencies": {
    "@oh-my-pi/pi-coding-agent": "16.4.5",
    "@oh-my-pi/pi-tui": "16.4.5",
    "@oh-my-pi/pi-agent-core": "16.4.5",
    "@oh-my-pi/pi-ai": "16.4.5"
  },
  "peerDependenciesMeta": {
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    },
    "@oh-my-pi/pi-tui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@oh-my-pi/pi-agent-core": "16.4.5",
    "@oh-my-pi/pi-ai": "16.4.5",
    "@oh-my-pi/pi-coding-agent": "16.4.5"
  }
}
