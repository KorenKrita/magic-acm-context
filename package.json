{
  "name": "magic-acm-context",
  "version": "0.1.0",
  "private": true,
  "description": "Magic Context + ACM (Active Context Management) unified extension for pi and omp",
  "workspaces": [
    "packages/plugin",
    "packages/pi-plugin",
    "packages/omp-plugin"
  ],
  "dependencies": {
    "@huggingface/transformers": "^4.1.0",
    "@jitl/quickjs-singlefile-cjs-release-asyncify": "0.32.0",
    "ai-tokenizer": "^1.0.6",
    "comment-json": "^5.0.0",
    "quickjs-emscripten": "^0.32.0",
    "typebox": "^1.3.1",
    "zod": "^4.1.8"
  },
  "scripts": {
    "build": "bun run --filter '*' build",
    "test": "bun run --filter '*' test",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "pi": {
    "extensions": [
      "./packages/pi-plugin/src/index.ts"
    ]
  },
  "omp": {
    "extensions": [
      "./packages/omp-plugin/src/index.ts"
    ]
  }
}
