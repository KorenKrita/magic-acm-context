{
  "name": "magic-acm-context",
  "version": "0.1.0",
  "private": true,
  "description": "Magic Context + ACM (Active Context Management) unified extension for pi and omp",
  "workspaces": [
    "packages/plugin",
    "packages/pi-plugin",
    "packages/omp-plugin"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "test": "bun run --filter '*' test",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "pi": {
    "extensions": [
      "./packages/pi-plugin/src/index.ts"
    ]
  },
  "omp": {
    "extensions": [
      "./packages/omp-plugin/dist/index.js"
    ]
  }
}
